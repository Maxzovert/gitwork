# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Local Postgres: set both to the same URL.
# Neon on Vercel: DATABASE_URL = pooler host + ?sslmode=require&pgbouncer=true
#                 DIRECT_URL   = non-pooler host (no -pooler) for migrate/db push
DATABASE_URL="postgresql://postgres:password@localhost:5432/gitwork"
DIRECT_URL="postgresql://postgres:password@localhost:5432/gitwork"

# Auth0 authentication (@auth0/nextjs-auth0 v4)
# APP_BASE_URL must match the URL you open in the browser (no trailing slash).
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET=""
APP_BASE_URL="http://localhost:3000"

# Server-side AI
GEMINI_API_KEY=""

# Meeting transcription and browser uploads
ASSEMBLY_API_KEY=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_FOLDER="gitwork"

# Public URL for GitHub webhooks (use ngrok in local dev)
APP_URL="http://localhost:3000"

# Optional fallback only. Prefer Auth0 GitHub connection (custom OAuth app with
# the `repo` scope) so each user authorizes once and can add many repos.
GITHUB_TOKEN=""

# Required when users store encrypted API tokens in Settings.
# Generate a 32-byte key, for example: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Optional for Docker or CI builds that inject variables later.
SKIP_ENV_VALIDATION=""

# Auth0 Application URLs (Dashboard → Applications → your app → Settings):
#   Allowed Callback URLs:  {APP_BASE_URL}/auth/callback
#   Allowed Logout URLs:    {APP_BASE_URL}   (exact origin — required for sign-out)
#   Allowed Web Origins:    {APP_BASE_URL}
#
# Consent “Authorize App” / “Verience account” is Auth0-hosted (not app UI):
#   Branding → Settings Friendly Name = Gitwork; Universal Login colors/logo.
#   localhost always shows consent once; production first-party apps can skip it.
# Auth0: enable GitHub under Authentication → Social. Use a GitHub OAuth App
# with the `repo` scope. Callback URL is typically:
#   https://YOUR_AUTH0_DOMAIN/login/callback
# Enable Database (Username-Password) for email sign-up on /sign-up.
# Optional override if your DB connection name differs:
# AUTH0_DB_CONNECTION="Username-Password-Authentication"
